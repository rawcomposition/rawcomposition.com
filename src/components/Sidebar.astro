---
import overview from '../../lifelist/overview.json';
import { getCountryName, getEbirdImgUrl } from '@/helpers/ebird';
import { speciesByDateDesc } from '@/helpers/lifelist';
import CountryRow from './CountryRow.astro';

type Props = {
	countryData: { code: string; count: number }[];
}

const { countryData } = Astro.props;

const [featuredLifer, ...recentLifers] = speciesByDateDesc.slice(0, 5);
const formatLiferDate = (date: string) =>
	new Date(date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<div class="bg-white p-10 w-full md:w-[33%] text-sm mb-8">
	<div class="text-center mb-12">
		<img class="w-[150px] rounded-full inline-block" src="/avatar.jpg" alt="" />
		<div>
			<h4 class="text-[#636467] uppercase font-bold font-heading mb-2 mt-6">Adam Jackson</h4>
			<p class="text-[0.85rem] text-zinc-500/80 leading-normal">
				I'm a software developer that loves chasing rare birds around world. I'm on a quest to photograph
				{' '}<strong>5,000 species</strong> in my lifetime, about 1/2 of the world's species.
			</p>
			<div class="mt-5 text-left">
				<div class="flex items-baseline text-xs text-zinc-500 mb-1.5">
					<span><strong class="text-zinc-600 text-sm">{overview.total.toLocaleString()}</strong> photographed</span>
					<span class="ml-auto">{Math.round((overview.total / 5000) * 100)}% of 5,000</span>
				</div>
				<div class="relative h-2.5 rounded-full bg-gray-200 overflow-hidden">
					<div class="absolute inset-y-0 left-0 rounded-full bg-[#f4793d]" style={`width: ${(overview.total / 5000) * 100}%`}></div>
				</div>
				<a href="/progress/" class="text-orange text-xs font-bold inline-block mt-2">View my progress &rarr;</a>
			</div>
		</div>
	</div>
	<h4 class="text-[#636467] uppercase font-bold font-heading mb-4">Latest Lifers</h4>

	<div class="space-y-2">
		<a href={`/lifelist/${overview.years[0]}`} class="relative block overflow-hidden rounded">
			<img
				src={getEbirdImgUrl(featuredLifer.img, 640)}
				width={featuredLifer.w}
				height={featuredLifer.h}
				alt={featuredLifer.name}
				loading="lazy"
				class="w-full aspect-[3/2] object-cover"
			/>
			<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-3 pb-2.5 pt-8">
				<span class="block font-heading font-bold text-white leading-tight">{featuredLifer.name}</span>
				<span class="block text-[0.7rem] text-white/70">{formatLiferDate(featuredLifer.date)}</span>
			</div>
		</a>
		<div class="grid grid-cols-2 gap-2">
			{recentLifers.map((sp) => (
				<a href={`/lifelist/${overview.years[0]}`} class="relative block overflow-hidden rounded">
					<img
						src={getEbirdImgUrl(sp.img, 320)}
						width={sp.w}
						height={sp.h}
						alt={sp.name}
						loading="lazy"
						class="w-full aspect-square object-cover"
					/>
					<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-2 pb-1.5 pt-6">
						<span class="block text-[0.7rem] font-heading font-bold text-white leading-tight">{sp.name}</span>
					</div>
				</a>
			))}
		</div>
	</div>
	<a href={`/lifelist/${overview.years[0]}`} class="text-orange text-xs font-bold inline-block mt-3">
		View all {overview.total.toLocaleString()} lifers &rarr;
	</a>

	<h4 class="text-[#636467] uppercase font-bold font-heading mb-4 mt-12">Birding Life List</h4>

	<div class="text-zinc-600">
		<ol class="bg-zebra">
			<CountryRow country="World" count={overview.total} link={`/lifelist/${overview.years[0]}`} />
			{countryData.map(({ code, count }) => (
				<CountryRow country={getCountryName(code)} {count} />
			))}
		</ol>
	</div>

	<h4 class="text-[#636467] uppercase font-bold font-heading mb-4 mt-12">Lists</h4>
	<ul class="space-y-2">
		<li>
			<a href={`/lifelist/${overview.years[0]}`} class="text-orange">World Life List</a>
		</li>
		<li>
			<a href="/families" class="text-orange">Taxonomic Families</a>
		</li>
	</ul>

	<h4 class="text-[#636467] uppercase font-bold font-heading mb-4 mt-12">Stuff I've Built</h4>
	<p class="text-zinc-600">
		Use
		{' '}<a href="https://birdplan.app" class="text-orange font-bold" target="_blank">BirdPlan.app</a>
		{' '}to plan your next birding adventure!
	</p>
</div>

