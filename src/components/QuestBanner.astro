---
import { getEbirdImgUrl } from '@/helpers/ebird';
import { getHeroLifer } from '@/helpers/lifelist';
import { getHeroColor } from '@/helpers/heroColor';
import overview from '../../lifelist/overview.json';

const LIFETIME_GOAL = 5000;

const { heroLifer, isOverride, heroPosition } = getHeroLifer();
const progressPercent = (overview.total / LIFETIME_GOAL) * 100;
const heroColor = await getHeroColor(heroLifer.img);
---

<a href="/progress/" class="group block overflow-hidden mb-10 text-white sm:flex" style={`background-color: ${heroColor}`}>
	<div class="relative overflow-hidden sm:order-2 sm:flex-1 aspect-[16/9] sm:aspect-auto sm:min-h-[340px]">
		<img
			src={getEbirdImgUrl(heroLifer.img, 1200)}
			alt={heroLifer.name}
			style={heroPosition ? { objectPosition: heroPosition } : undefined}
			class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-[1.03]"
		/>
		<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent px-5 pt-10 pb-3 text-right">
			<span class="block uppercase text-[0.6rem] font-bold tracking-wider text-white/60">{isOverride ? 'Recent addition' : 'Latest addition'}</span>
			<span class="block font-heading text-sm font-bold">{heroLifer.name}</span>
		</div>
	</div>

	<div class="relative sm:order-1 sm:w-[42%] p-8 sm:p-10 flex flex-col justify-center">
		<p class="uppercase text-[0.7rem] font-bold tracking-wider text-orange-300 mb-2">The quest</p>
		<h2 class="font-heading text-2xl sm:text-[1.75rem] leading-snug font-bold mb-6">
			Photographing 5,000 of the world's bird species
		</h2>
		<div class="flex items-baseline gap-2 mb-3">
			<span class="font-heading text-5xl font-bold">{overview.total.toLocaleString()}</span>
			<span class="text-white/60">of {LIFETIME_GOAL.toLocaleString()}</span>
		</div>
		<div class="h-1.5 rounded-full bg-white/15 overflow-hidden mb-8">
			<div class="h-full rounded-full bg-[#f4793d]" style={`width: ${progressPercent}%`}></div>
		</div>
		<span class="text-sm font-bold text-orange-300 group-hover:text-orange-200">Follow my progress &rarr;</span>
	</div>
</a>
