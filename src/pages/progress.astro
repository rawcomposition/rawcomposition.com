---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import WorldMap from '@/components/WorldMap.astro';
import { getEbirdImgUrl, getCountryName, getCountryData } from '@/helpers/ebird';
import { allSpecies, familyData, speciesByDateDesc, getHeroLifer } from '@/helpers/lifelist';
import { SHOW_ENDEMICS } from '@/consts';
import { getHeroColor } from '@/helpers/heroColor';
import overview from '../../lifelist/overview.json';
import taxonomy from '../../taxonomy.json';
import islandEndemics from '../../island-endemics';

const LIFETIME_GOAL = 5000;
const YEARLY_GOAL = 100;
const FAVORITE_FAMILIES = ['Hummingbirds', 'Owls'];
const TOP_COUNTRIES = 10;

const ebirdUserId = import.meta.env.PUBLIC_EBIRD_USER_ID;
const lifelistUrl = `/lifelist/${overview.years[0]}`;
const photoLink = (code: string) =>
	`https://media.ebird.org/catalog?taxonCode=${code}&sort=rating_rank_desc&mediaType=photo&userId=${ebirdUserId}`;
const formatDate = (date: string, opts: Intl.DateTimeFormatOptions) => new Date(date).toLocaleDateString('en-US', opts);

const speciesByCode = new Map(allSpecies.map((it) => [it.code, it]));
const taxonomyData = taxonomy as { code: string; name: string; family: string }[];
const speciesNames = new Map(taxonomyData.map((it) => [it.code, it.name]));

// Lifetime quest
const photographedTotal = overview.total;
const lifetimePercent = (photographedTotal / LIFETIME_GOAL) * 100;
const recentLifers = speciesByDateDesc.slice(0, 8);
const { heroLifer, isOverride, heroPosition } = getHeroLifer();
const heroColor = await getHeroColor(heroLifer.img);

// This year
const currentYear = String(new Date().getFullYear());
const yearPhotographed = allSpecies.filter((it) => it.year === currentYear).length;
const yearGoalPercent = Math.min((yearPhotographed / YEARLY_GOAL) * 100, 100);

// New species by year chart
const photoYearCounts = new Map<string, number>();
allSpecies.forEach((sp) => photoYearCounts.set(sp.year, (photoYearCounts.get(sp.year) ?? 0) + 1));
const firstYear = Math.min(...[...photoYearCounts.keys()].map(Number));
const chartYears = Array.from({ length: Number(currentYear) - firstYear + 1 }, (_, i) => {
	const year = String(firstYear + i);
	return { year, count: photoYearCounts.get(year) ?? 0 };
});
const chartMax = Math.max(...chartYears.map((it) => it.count), YEARLY_GOAL);
const yMax = Math.ceil(chartMax / 100) * 100 + 50;
const yTicks = Array.from({ length: Math.floor(yMax / 100) + 1 }, (_, i) => i * 100);
const chart = { width: 860, height: 260, top: 24, right: 14, bottom: 26, left: 38 };
const plotW = chart.width - chart.left - chart.right;
const plotH = chart.height - chart.top - chart.bottom;
const slotW = plotW / chartYears.length;
const barW = Math.min(22, slotW - 8);
const yScale = (value: number) => chart.top + plotH - (value / yMax) * plotH;
const maxYearCount = Math.max(...chartYears.map((it) => it.count));
const brandOrange = '#e2632a';

// Favorite families
const favoriteFamilies = FAVORITE_FAMILIES.map((name) => {
	const species = familyData.find((it) => it.family === name)?.species ?? [];
	const total = taxonomyData.filter((it) => it.family === name).length;
	const recent = [...species].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
	const slug = name.toLowerCase().replaceAll(' ', '-').replaceAll("'", '').replaceAll(',', '');
	return { name, slug, count: species.length, total, recent };
});

// Countries
const flagEmoji = (code: string) =>
	String.fromCodePoint(...[...code.toUpperCase()].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65));
const countryData = await getCountryData();
const countries = countryData.map(({ code, count }) => ({
	code,
	count,
	name: getCountryName(code),
	flag: flagEmoji(code),
	link: `https://media.ebird.org/catalog?regionCode=${code}&sort=rating_rank_desc&mediaType=photo&userId=${ebirdUserId}`,
}));
const topCountries = countries.slice(0, TOP_COUNTRIES);
const otherCountries = countries.slice(TOP_COUNTRIES);
const maxCountryCount = countries[0]?.count ?? 1;

// Island endemics
const endemicIslands = islandEndemics.map((island) => {
	const species = island.species.map((sp) => ({
		...sp,
		name: speciesNames.get(sp.code) ?? sp.code,
		photo: speciesByCode.get(sp.code),
	}));
	return {
		name: island.name,
		flag: flagEmoji(island.regionCodes[0]),
		species,
		photographed: species.filter((sp) => sp.photo).length,
	};
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="The Quest | RawComposition.com"
			description={`Tracking my quest to photograph ${LIFETIME_GOAL.toLocaleString()} bird species — ${photographedTotal.toLocaleString()} so far`}
		/>
	</head>
	<body>
		<Header noMargin />

		<!-- Hero -->
		<div class="relative bg-neutral-900">
			<img
				src={getEbirdImgUrl(heroLifer.img, 2400)}
				alt={heroLifer.name}
				style={heroPosition ? { objectPosition: heroPosition } : undefined}
				class="w-full object-cover aspect-[4/3] sm:aspect-[2.4]"
			/>
			<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/50 to-transparent pt-16 pb-3 px-5 text-right text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]">
				<p class="uppercase text-[0.6rem] font-bold tracking-wider text-white/70">
					{isOverride ? 'Recent addition' : `Latest addition · #${photographedTotal.toLocaleString()}`}
				</p>
				<p class="font-heading text-sm sm:text-base font-bold leading-tight">{heroLifer.name}</p>
				<p class="text-[0.7rem] text-white/70">{formatDate(heroLifer.date, { month: 'long', day: 'numeric', year: 'numeric' })}</p>
			</div>
		</div>

		<div class="text-white" style={`background-color: ${heroColor}`}>
			<div class="mx-auto max-w-[1200px] px-4 py-12 sm:py-16 lg:flex items-center gap-16">
				<div class="flex-1 mb-8 lg:mb-0">
					<p class="uppercase text-[0.7rem] font-bold tracking-wider text-orange-300 mb-2">The quest</p>
					<h1 class="font-heading text-3xl sm:text-4xl lg:text-[2.75rem] leading-tight font-bold mb-4">
						Photographing 5,000 of the world's bird species
					</h1>
					<p class="text-white/70 text-sm sm:text-base max-w-xl">
						There are over 10,000 bird species on Earth. My lifelong goal is to photograph at least half of them.
					</p>
				</div>
				<div class="lg:w-[380px] shrink-0">
					<div class="flex items-baseline gap-2 mb-3">
						<span class="font-heading text-6xl font-bold">{photographedTotal.toLocaleString()}</span>
						<span class="text-white/60 text-lg">of {LIFETIME_GOAL.toLocaleString()} species</span>
					</div>
					<div class="h-1.5 rounded-full bg-white/20 overflow-hidden">
						<div class="h-full rounded-full bg-[#f4793d]" style={`width: ${lifetimePercent}%`}></div>
					</div>
				</div>
			</div>
		</div>

		<div class="bg-white">
		<div class="mx-auto max-w-[1200px] px-4">
			<!-- Recent additions -->
			<section class="py-12 sm:py-16">
				<div class="flex items-baseline gap-4 mb-6">
					<h2 class="font-heading text-neutral-600 text-2xl sm:text-3xl">Newest Additions</h2>
					<a href={lifelistUrl} class="ml-auto text-orange text-sm font-bold whitespace-nowrap">All {photographedTotal.toLocaleString()} species &rarr;</a>
				</div>
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
					{recentLifers.map((sp) => (
						<a href={photoLink(sp.code)} target="_blank" rel="noopener noreferrer" class="group relative block overflow-hidden aspect-square">
							<img
								src={getEbirdImgUrl(sp.img, 640)}
								alt={sp.name}
								loading="lazy"
								class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
							/>
							<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent pt-10 pb-2.5 px-3">
								<p class="font-heading text-sm font-bold leading-tight text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.9)]">{sp.name}</p>
								<p class="text-[0.7rem] text-white/70">{formatDate(sp.date, { month: 'short', day: 'numeric', year: 'numeric' })}</p>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- Favorite families -->
			<section class="pb-12 sm:pb-16">
				<div class="flex items-baseline gap-4 mb-2">
					<h2 class="font-heading text-neutral-600 text-2xl sm:text-3xl">Family Quests</h2>
					<a href="/families" class="ml-auto text-orange text-sm font-bold whitespace-nowrap">All families &rarr;</a>
				</div>
				<p class="text-gray-500 mb-6">Birds are grouped into families. These are the ones I'm trying to complete.</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
					{favoriteFamilies.map(({ name, slug, count, total, recent }) => (
						<a href={`/families/${slug}`} class="group relative block overflow-hidden bg-neutral-900">
							<div class="grid grid-cols-3 gap-0.5">
								{recent.map((sp) => (
									<img src={getEbirdImgUrl(sp.img, 480)} alt={sp.name} loading="lazy" class="w-full aspect-[4/5] object-cover" />
								))}
							</div>
							<div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/50 to-transparent pt-16 pb-5 px-5 text-white">
								<div class="flex items-baseline mb-2.5">
									<h3 class="font-heading text-2xl font-bold group-hover:text-orange-300 [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]">{name}</h3>
									<span class="ml-auto text-sm text-white/70 [text-shadow:0_1px_3px_rgba(0,0,0,0.8)]">
										<strong class="text-white text-lg">{count}</strong> of {total}
									</span>
								</div>
								<div class="h-1 rounded-full bg-white/25 overflow-hidden">
									<div class="h-full rounded-full bg-[#f4793d]" style={`width: ${(count / total) * 100}%`}></div>
								</div>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- Countries -->
			<section class="pb-12 sm:pb-16">
				<h2 class="font-heading text-neutral-600 text-2xl sm:text-3xl mb-2">Around the World</h2>
				<p class="text-gray-500 mb-8">Bird species seen in each of the {countries.length} countries I've birded</p>
				<div class="lg:flex gap-12 items-start">
					<div class="flex-1 mb-8 lg:mb-0">
						<WorldMap counts={countryData} ebirdUserId={ebirdUserId} />
					</div>
					<div class="lg:w-[300px] shrink-0">
						<ol class="divide-y divide-gray-100">
							{topCountries.map(({ name, flag, count, link }) => (
								<li>
									<a href={link} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 py-2 text-sm" title={`View my photos from ${name} on eBird`}>
										<span class="text-lg leading-none">{flag}</span>
										<span class="text-gray-600 group-hover:text-orange truncate flex-1">{name}</span>
										<span class="w-16 h-1 rounded-full bg-gray-100 overflow-hidden hidden sm:block">
											<span class="block h-full bg-[#f4793d]" style={`width: ${(count / maxCountryCount) * 100}%`}></span>
										</span>
										<span class="font-heading font-bold text-neutral-700 w-10 text-right">{count.toLocaleString()}</span>
									</a>
								</li>
							))}
						</ol>
						{otherCountries.length > 0 && (
							<details class="mt-3 text-sm">
								<summary class="cursor-pointer text-orange font-bold list-none">+ {otherCountries.length} more countries</summary>
								<ul class="mt-2 columns-2 text-gray-600">
									{otherCountries.map(({ name, flag, count, link }) => (
										<li class="py-1 flex gap-2 pr-4">
											<span>{flag}</span>
											<a href={link} target="_blank" rel="noopener noreferrer" class="hover:text-orange truncate flex-1">{name}</a>
											<span class="text-gray-400">{count}</span>
										</li>
									))}
								</ul>
							</details>
						)}
					</div>
				</div>
			</section>

			<!-- Endemics -->
			{SHOW_ENDEMICS && (
				<section class="pb-12 sm:pb-16">
					<h2 class="font-heading text-neutral-600 text-2xl sm:text-3xl mb-2">Island Endemics</h2>
					<p class="text-gray-500 mb-8">
						Some islands are home to birds found nowhere else on Earth. I'm trying to photograph every one.
					</p>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-10">
						{endemicIslands.map(({ name, flag, species, photographed }) => (
							<div>
								<div class="flex items-baseline mb-3">
									<h3 class="font-heading text-xl font-bold text-neutral-600"><span class="mr-1.5">{flag}</span>{name}</h3>
									<span class="ml-auto text-sm text-gray-500"><strong class="text-neutral-600 text-lg">{photographed}</strong> of {species.length}</span>
								</div>
								<div class="grid grid-cols-4 sm:grid-cols-5 gap-1">
									{species.map((sp) => (
										<a
											href={sp.photo ? photoLink(sp.code) : `https://ebird.org/species/${sp.code}`}
											target="_blank"
											rel="noopener noreferrer"
											title={`${sp.name}${sp.isNear ? ' (near-endemic)' : ''}${sp.notes ? ` — ${sp.notes}` : ''}`}
											class="group relative block aspect-square overflow-hidden bg-gray-100"
										>
											{sp.photo ? (
												<img src={getEbirdImgUrl(sp.photo.img, 320)} alt={sp.name} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
											) : (
												<span class="absolute inset-0 flex items-center justify-center text-gray-300">
													<svg viewBox="0 0 24 24" class="w-7 h-7" fill="currentColor" aria-hidden="true">
														<path d="M21 6.5c0-1.5-1.2-2.5-2.6-2.5-1 0-1.8.5-2.3 1.3L3 13.5l2.3.6 6.6-3.2c-.6 1.3-.5 2.8.2 4.1L10 19h2.6l1.6-3.2c1.9.2 3.6-1 4.2-2.8l.6-2.6 2-1.6V6.5z" />
													</svg>
												</span>
											)}
											<span class="absolute inset-x-0 bottom-0 bg-black/70 text-white text-[0.6rem] leading-tight px-1 py-0.5 truncate opacity-0 group-hover:opacity-100 transition-opacity">
												{sp.name}
											</span>
										</a>
									))}
								</div>
							</div>
						))}
					</div>
				</section>
			)}
		</div>
		</div>

		<!-- By the numbers -->
		<section class="bg-neutral-50 border-t border-gray-200 py-12 sm:py-16">
			<div class="mx-auto max-w-[1200px] px-4">
				<h2 class="font-heading text-neutral-600 text-2xl sm:text-3xl mb-10">By the Numbers</h2>
				<div class="lg:flex gap-12">
					<div class="lg:w-[300px] shrink-0 mb-10 lg:mb-0">
						<p class="uppercase text-[0.7rem] font-bold tracking-wider text-gray-400 mb-3">This year</p>
						<div class="flex items-baseline gap-2 mb-3">
							<span class="font-heading text-5xl font-bold text-neutral-700">{yearPhotographed}</span>
							<span class="text-gray-500">of {YEARLY_GOAL}</span>
						</div>
						<div class="h-1.5 rounded-full bg-gray-200 overflow-hidden mb-3">
							<div class="h-full rounded-full bg-[#f4793d]" style={`width: ${yearGoalPercent}%`}></div>
						</div>
						<p class="text-sm text-gray-500">I aim to photograph {YEARLY_GOAL} new species every year.</p>
						<a href={lifelistUrl} class="inline-block text-orange text-sm font-bold mt-4">This year's photos &rarr;</a>
					</div>

					<div class="flex-1 min-w-0">
						<p class="uppercase text-[0.7rem] font-bold tracking-wider text-gray-400 mb-3">New species each year</p>
						<div class="relative">
							<svg viewBox={`0 0 ${chart.width} ${chart.height}`} class="w-full" id="lifers-chart" role="img" aria-label="Bar chart of new species photographed per year">
								{yTicks.map((tick) => (
									<>
										<line x1={chart.left} x2={chart.width - chart.right} y1={yScale(tick)} y2={yScale(tick)} stroke="#f0f0f0" stroke-width="1" />
										<text x={chart.left - 8} y={yScale(tick) + 3} text-anchor="end" font-size="10" fill="#9ca3af">{tick}</text>
									</>
								))}
								<line
									x1={chart.left}
									x2={chart.width - chart.right}
									y1={yScale(YEARLY_GOAL)}
									y2={yScale(YEARLY_GOAL)}
									stroke="#a3a3a3"
									stroke-width="1"
									stroke-dasharray="4 4"
								/>
								<text x={chart.left + 6} y={yScale(YEARLY_GOAL) - 5} text-anchor="start" font-size="10" fill="#737373" stroke="#ffffff" stroke-width="3.5" paint-order="stroke">
									Yearly goal
								</text>
								{chartYears.map(({ year, count }, i) => {
									const x = chart.left + i * slotW + slotW / 2;
									const y = yScale(count);
									const showLabel = count === maxYearCount || year === currentYear;
									return (
										<>
											<path
												d={`M ${x - barW / 2} ${chart.top + plotH} V ${y + 4} Q ${x - barW / 2} ${y} ${x - barW / 2 + 4} ${y} H ${x + barW / 2 - 4} Q ${x + barW / 2} ${y} ${x + barW / 2} ${y + 4} V ${chart.top + plotH} Z`}
												fill={year === currentYear ? brandOrange : '#f8a76c'}
												class="chart-bar"
												data-year={year}
												data-count={count}
											/>
											{showLabel && (
												<text x={x} y={y - 6} text-anchor="middle" font-size="11" font-weight="bold" fill="#525252" stroke="#ffffff" stroke-width="3.5" paint-order="stroke">
													{count}
												</text>
											)}
											<text x={x} y={chart.height - 8} text-anchor="middle" font-size="10" fill="#9ca3af">&rsquo;{year.slice(2)}</text>
											<rect x={chart.left + i * slotW} y={chart.top} width={slotW} height={plotH} fill="transparent" class="chart-hit" data-year={year} data-count={count} />
										</>
									);
								})}
								<line x1={chart.left} x2={chart.width - chart.right} y1={chart.top + plotH} y2={chart.top + plotH} stroke="#d1d5db" stroke-width="1" />
							</svg>
							<div
								id="chart-tooltip"
								class="pointer-events-none absolute hidden -translate-x-1/2 -translate-y-full rounded bg-neutral-800 px-2.5 py-1.5 text-xs text-white whitespace-nowrap"
							></div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<script>
			const tooltip = document.getElementById('chart-tooltip');
			const chart = document.getElementById('lifers-chart');
			const currentYear = String(new Date().getFullYear());
			document.querySelectorAll('.chart-hit').forEach((hit) => {
				const year = hit.getAttribute('data-year');
				const bar = chart?.querySelector(`.chart-bar[data-year="${year}"]`) as SVGGraphicsElement | null;
				const baseFill = bar?.getAttribute('fill') ?? '#f8a76c';
				hit.addEventListener('mouseenter', () => {
					if (!tooltip || !chart) return;
					const count = hit.getAttribute('data-count');
					tooltip.innerHTML = `<strong>${year}</strong> &middot; ${count} new species`;
					const chartRect = chart.getBoundingClientRect();
					const hitRect = hit.getBoundingClientRect();
					const barRect = bar?.getBoundingClientRect();
					tooltip.style.left = `${hitRect.left + hitRect.width / 2 - chartRect.left}px`;
					tooltip.style.top = `${(barRect?.top ?? hitRect.top) - chartRect.top - 6}px`;
					tooltip.classList.remove('hidden');
					bar?.setAttribute('fill', year === currentYear ? '#c9571f' : '#e2632a');
				});
				hit.addEventListener('mouseleave', () => {
					tooltip?.classList.add('hidden');
					bar?.setAttribute('fill', baseFill);
				});
			});
		</script>
	</body>
</html>
